# ==============================================================================
# OpenSpell Core Nomad Job Variables (API, Web, Chat)
# ==============================================================================
# Usage:
#   nomad job run -var-file deploy/nomad/vars/core.vars.hcl deploy/nomad/core.hcl
#   nomad job run -var "image_tag=v0.1.4" deploy/nomad/core.hcl
# ==============================================================================

# Base container registry
image_registry = "ghcr.io/metsutan/openspell"

# Global image tag for core services
image_tag      = "latest"

# Force pull images when starting tasks
force_pull     = true

# ------------------------------------------------------------------------------
# Optional Service-Specific Overrides
# Uncomment to override individual service image tags or full image paths:
# ------------------------------------------------------------------------------
# api_tag    = "v0.1.3"
# web_tag    = "v0.1.3"
# chat_tag   = "v0.1.3"

# api_image  = "ghcr.io/metsutan/openspell/api:v0.1.3"
# web_image  = "ghcr.io/metsutan/openspell/web:v0.1.3"
# chat_image = "ghcr.io/metsutan/openspell/chat:v0.1.3"

# curl_image = "docker.io/curlimages/curl:latest"
