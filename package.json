{
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"protocol:generate": "node apps/game/tools/generate-protocol-from-factory.js --overwrite",
		"env:secrets": "node scripts/update-shared-secrets.js",
		"postinstall": "node -e \"if (require('fs').existsSync('apps/game/tools/generate-protocol-from-factory.js')) { require('child_process').execSync('node apps/game/tools/generate-protocol-from-factory.js --overwrite', {stdio: 'inherit'}); }\""
	},
	"dependencies": {
		"dotenv": "^17.2.3",
		"pngjs": "^7.0.0"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1034.0",
		"@aws-sdk/lib-storage": "^3.600.0"
	},
	"pnpm": {
		"minimumReleaseAge": 0
	},
	"packageManager": "pnpm@9.15.4"
}
