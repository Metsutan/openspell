---
import Layout from '@/layouts/Layout.astro';
import { getUserInfo } from '@/lib/auth';
import { makeApiRequest } from '@/lib/api';
import { formatNumber } from '@/lib/helpers';
import { getCsrfToken } from '@/lib/csrf';

interface Skill {
  id: number;
  slug: string;
  title: string;
  iconPosition?: string;
}

interface World {
  serverId: number;
  name: string;
  isActive?: boolean;
}

interface PlayerStat {
  skill: string;
  rank?: number | null;
  level?: number | null;
  experience?: number | bigint | null;
}

const user = await getUserInfo(Astro.cookies);
const csrfToken = getCsrfToken(Astro.cookies);
const displayName = Astro.params.displayName || '';
const normalizedName = displayName.trim().toLowerCase();
const isHiddenUser = normalizedName === 'admin';

let worlds: World[] = [];
try {
  const worldsRes = await makeApiRequest<{ worlds: World[] }>('/api/worlds');
  worlds = worldsRes?.worlds || [];
} catch (_) {}

let selectedServerId = 1;
const queryServerId = Astro.url.searchParams.get('serverId');
if (queryServerId) {
  const parsed = parseInt(queryServerId, 10);
  if (worlds.some((w) => w.serverId === parsed)) {
    selectedServerId = parsed;
  }
} else if (worlds.length > 0) {
  const active = worlds.find((w) => w.isActive) || worlds[0];
  if (active) selectedServerId = active.serverId;
}

let skills: Skill[] = [];
try {
  const skillsRes = await makeApiRequest<{ skills: Skill[] }>('/api/hiscores/skills');
  skills = skillsRes?.skills || [];
} catch (_) {}

let playerStats: { player?: any; stats?: PlayerStat[] } | null = null;
if (!isHiddenUser) {
  try {
    const data = await makeApiRequest<{ player: any; stats: PlayerStat[] }>(
      `/api/hiscores/player/${encodeURIComponent(displayName)}?serverId=${selectedServerId}`
    );
    if (data && data.player) {
      playerStats = data;
    }
  } catch (_) {}
}

const serverQuery = `serverId=${selectedServerId}`;
const player = playerStats?.player;
const stats = playerStats?.stats || [];
const playerTitle = player?.displayName || player?.username || displayName;
---

<Layout
  title={player ? `OpenSpell - HiScores - ${playerTitle}` : 'OpenSpell - HiScores - Player not found'}
  description={player ? `View stats for ${playerTitle}` : 'Player not found'}
  user={user}
  hiscoresWorlds={worlds.map((w) => ({ serverId: w.serverId, name: w.name }))}
  selectedServerId={selectedServerId}
  hiscoresSelectBaseUrl={`/hiscores/player/${encodeURIComponent(displayName)}?serverId=`}
>
  <section id="hs-page">
    <h1 class="sect-h" id="hs-h">
      <div id="hs-menu-toggle-wrap">
        <button id="hs-menu-toggle" class="hb-btn" type="button">
          <div id="hs-menu-icon"></div>
        </button>
      </div>
      <span>HiScores</span>
    </h1>

    <div id="hs-box" class="content-box">
      <ul id="sk-menu" class="card">
        <li>
          <div style="width:100%;display:flex;justify-content:center;">
            <a href={`/hiscores/overall?${serverQuery}`} title="All Hiscores" class="sk-link">All Hiscores</a>
          </div>
        </li>
        {skills.map((s) => (
          <li>
            <a href={`/hiscores/${s.slug}?${serverQuery}`} title={s.title} class="sk-link">
              {s.title}
              <span class="sk-ico" style={s.iconPosition ? `background-position: ${s.iconPosition};` : ''}></span>
            </a>
          </li>
        ))}
        <li>
          <div>
            <form action="/hiscores/player" method="POST">
              <input type="hidden" name="_csrf" value={csrfToken} />
              <input type="hidden" name="serverId" value={String(selectedServerId)} />
              <div class="hs-search">
                <div>Player Search</div>
                <div>
                  <input type="text" maxlength="16" id="search-player" name="username" placeholder="Username" required />
                </div>
                <div>
                  <input type="submit" name="submit" value="Search" />
                </div>
              </div>
            </form>
          </div>
        </li>
      </ul>

      <div class="hs-tbl-wrap">
        <ul id="hs-tbl" class="card">
          {!player ? (
            <li>
              <div class="hs-h">
                <h3>Player not found</h3>
              </div>
              <li id="hs-hdr" class="hs-row">
                <div class="hs-row__rank">Rank</div>
                <div class="hs-row__name">Skill</div>
                <div class="hs-row__level">Level</div>
                <div class="hs-row__exp">Experience</div>
              </li>
              <li class="hs-row hs-empty">
                At least one skill needs to be level 30 or higher to appear on the hiscores
              </li>
            </li>
          ) : (
            <>
              <li>
                <div class="hs-h">
                  <h2>{playerTitle}</h2>
                </div>
              </li>
              <li id="hs-hdr" class="hs-row">
                <div class="hs-rank">Rank</div>
                <div class="hs-name">Skill</div>
                <div class="hs-lvl">Level</div>
                <div class="hs-exp">Experience</div>
              </li>

              {stats.map((stat) => {
                const sk = skills.find((s) => s.slug === stat.skill);
                const skillTitle = sk?.title || stat.skill;
                const rankText = stat.rank !== null && stat.rank !== undefined ? formatNumber(stat.rank) : 'No Rank';
                const levelText = stat.level !== null && stat.level !== undefined ? stat.level : '-';
                const expText = stat.experience !== null && stat.experience !== undefined ? formatNumber(stat.experience) : '-';

                return (
                  <li class="hs-row sel">
                    <div class="hs-rank">{rankText}</div>
                    <div class="hs-name">
                      <a href={`/hiscores/${stat.skill}?${serverQuery}`} title={skillTitle} class="hs-name-link">
                        {sk && sk.iconPosition && (
                          <span class="sk-ico" style={`background-position: ${sk.iconPosition};`}></span>
                        )}
                        {skillTitle}
                      </a>
                    </div>
                    <div class="hs-lvl">{levelText}</div>
                    <div class="hs-exp">{expText}</div>
                  </li>
                );
              })}
            </>
          )}
        </ul>
      </div>
    </div>
  </section>
</Layout>
