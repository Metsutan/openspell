---
import Layout from '@/layouts/Layout.astro';
import { getUserInfo } from '@/lib/auth';
import { makeApiRequest, extractApiErrorMessage } from '@/lib/api';
import { getCsrfToken, validateCsrfToken } from '@/lib/csrf';
import { sanitizeString } from '@/lib/helpers';

const user = await getUserInfo(Astro.cookies);
const csrfToken = getCsrfToken(Astro.cookies);

let errorMessage = Astro.url.searchParams.get('error') || '';
let successMessage = Astro.url.searchParams.get('success') || '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const submittedCsrf = String(formData.get('_csrf') || '');
    if (!validateCsrfToken(Astro.cookies, submittedCsrf)) {
      errorMessage = 'Invalid form submission.';
    } else {
      const email = sanitizeString(formData.get('email'));
      if (!email) {
        errorMessage = 'Email is required';
      } else {
        try {
          const res = await makeApiRequest<{ success: boolean; error?: string }>('/api/auth/forgot-password', {
            method: 'POST',
            body: { email }
          });
          if (res && res.success) {
            successMessage = 'If an account exists with that email, a password reset link has been sent.';
          } else {
            errorMessage = res?.error || 'Failed to send reset email';
          }
        } catch (err) {
          errorMessage = extractApiErrorMessage(err);
        }
      }
    }
  } catch (_) {
    errorMessage = 'Internal server error';
  }
}
---

<Layout title="OpenSpell - Forgot Password" user={user}>
  <section id="forgot-password">
    <div class="auth-wrap">
      <div class="auth-card card">
        <div id="login-brand-img" title="OpenSpell"></div>
        <div class="frm-wrap">
          {successMessage && (
            <div style="color: #00aa00; margin-bottom: 16px; padding: 12px; background: #00aa0020; border-radius: 4px;">
              {successMessage}
            </div>
          )}
          {errorMessage && (
            <div style="color: #ff4444; margin-bottom: 16px; padding: 12px; background: #ff444420; border-radius: 4px;">
              {errorMessage}
            </div>
          )}

          <h2>Reset Password</h2>
          <p>Enter your email address and we'll send you a link to reset your password.</p>

          <form action="/forgot-password" method="POST">
            <input type="hidden" name="_csrf" value={csrfToken} />

            <div class="frm-row">
              <label for="email-input">Email Address</label>
              <input type="email" id="email-input" name="email" maxlength="255" placeholder="Email" required />
            </div>

            <div class="frm-row frm-row--cntr">
              <input type="submit" class="btn-submit" value="Send Reset Link" />
            </div>

            <div class="frm-row frm-row--cntr" style="margin-top:24px;">
              <a href="/login">Back to Login</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
