---
import Layout from "@/layouts/Layout.astro";
import { getUserInfo } from "@/lib/auth";
import { makeApiRequest, extractApiErrorMessage } from "@/lib/api";
import { getCsrfToken, validateCsrfToken } from "@/lib/csrf";

const user = await getUserInfo(Astro.cookies);
const token = Astro.url.searchParams.get("token") || "";

if (!token && Astro.request.method !== "POST") {
  return Astro.redirect("/forgot-password?error=Invalid%20reset%20token");
}

const csrfToken = getCsrfToken(Astro.cookies);
let errorMessage = Astro.url.searchParams.get("error") || "";
let successMessage = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const submittedCsrf = String(formData.get("_csrf") || "");
    if (!validateCsrfToken(Astro.cookies, submittedCsrf)) {
      errorMessage = "Invalid form submission.";
    } else {
      const resetToken = String(formData.get("token") || token);
      const newPassword = String(formData.get("new-password") || "");
      const confirmPassword = String(formData.get("confirm-password") || "");

      if (!resetToken || !newPassword) {
        errorMessage = "Token and new password are required";
      } else if (newPassword !== confirmPassword) {
        errorMessage = "Passwords do not match";
      } else if (newPassword.length < 8) {
        errorMessage = "Password must be at least 8 characters";
      } else {
        try {
          const res = await makeApiRequest<{
            success: boolean;
            error?: string;
          }>("/api/auth/reset-password", {
            method: "POST",
            body: { token: resetToken, newPassword },
          });
          if (res && res.success) {
            return Astro.redirect(
              "/login?success=Password%20reset%20successfully.%20Please%20login%20with%20your%20new%20password.",
            );
          } else {
            errorMessage = res?.error || "Failed to reset password";
          }
        } catch (err) {
          errorMessage = extractApiErrorMessage(err);
        }
      }
    }
  } catch (_) {
    errorMessage = "Internal server error";
  }
}
---

<Layout title="OpenSpell - Reset Password" user={user}>
  <section id="reset-password">
    <div class="auth-wrap">
      <div class="auth-card card">
        <div id="login-brand-img" title="OpenSpell"></div>
        <div class="frm-wrap">
          {
            errorMessage && (
              <div style="color: #ff4444; margin-bottom: 16px; padding: 12px; background: #ff444420; border-radius: 4px;">
                {errorMessage}
              </div>
            )
          }

          <h2>Reset Password</h2>
          <p>Enter your new password below.</p>

          <form action="/reset-password" method="POST">
            <input type="hidden" name="_csrf" value={csrfToken} />
            <input type="hidden" name="token" value={token} />

            <div class="frm-row">
              <label for="new-password-input">New Password</label>
              <input
                type="password"
                id="new-password-input"
                name="new-password"
                maxlength="64"
                placeholder="New Password (min 8 characters)"
                required
              />
            </div>

            <div class="frm-row">
              <label for="confirm-password-input">Confirm New Password</label>
              <input
                type="password"
                id="confirm-password-input"
                name="confirm-password"
                maxlength="64"
                placeholder="Confirm New Password"
                required
              />
            </div>

            <div class="frm-row frm-row--cntr">
              <input type="submit" class="btn-submit" value="Reset Password" />
            </div>

            <div class="frm-row frm-row--cntr" style="margin-top:24px;">
              <a href="/login">Back to Login</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
