---
const currentYear = new Date().getFullYear();
const startYear = 2025;
const yearRange =
  currentYear === startYear ? `${startYear}` : `${startYear}-${currentYear}`;
---

<footer id="ft">
  <div></div>
  <div id="ft-content"></div>
  <div id="cp-txt">{yearRange} OpenSpell</div>
  <div></div>
</footer>
